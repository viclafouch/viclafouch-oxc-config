{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "types": ["vitest/globals", "node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "index.ts",
    "configs/**/*.ts",
    "formatting/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts"
  ]
}
