{
  "name": "@viclafouch/oxc-config",
  "version": "1.0.0",
  "description": "Oxlint and Oxfmt configuration for modern TypeScript, React, Next.js, and React Native projects.",
  "keywords": [
    "config",
    "formatter",
    "linter",
    "nextjs",
    "oxc",
    "oxfmt",
    "oxlint",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/viclafouch/oxc-config#readme",
  "bugs": {
    "url": "https://github.com/viclafouch/oxc-config/issues"
  },
  "license": "MIT",
  "author": "Victor de la Fouchardiere <victor.delafouchardiere@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viclafouch/oxc-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./formatting": "./dist/formatting/index.mjs",
    "./plugins/viclafouch": "./dist/plugins/viclafouch/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "tsdown && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsdown && oxlint && oxfmt --check",
    "lint:fix": "tsdown && oxlint --fix && oxfmt",
    "prepublishOnly": "tsdown",
    "bump": "npm version minor",
    "release": "npm publish"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.88.0",
    "oxlint-plugin-react-doctor": "^0.9.18"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@tanstack/eslint-plugin-query": "^5.104.3",
    "@types/node": "^26.6.5",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-turbo": "^2.11.9",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@tanstack/eslint-plugin-query": ">= 5",
    "eslint-plugin-playwright": ">= 2",
    "eslint-plugin-react-native": ">= 5",
    "eslint-plugin-testing-library": ">= 7",
    "eslint-plugin-turbo": ">= 2",
    "oxfmt": ">= 0.73",
    "oxlint": ">= 1.88",
    "typescript": ">= 5"
  },
  "peerDependenciesMeta": {
    "@tanstack/eslint-plugin-query": {
      "optional": true
    },
    "eslint-plugin-playwright": {
      "optional": true
    },
    "eslint-plugin-react-native": {
      "optional": true
    },
    "eslint-plugin-testing-library": {
      "optional": true
    },
    "eslint-plugin-turbo": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    }
  }
}
