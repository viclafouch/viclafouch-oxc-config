{
  "name": "@viclafouch/oxc-config",
  "version": "2.0.0",
  "description": "Oxlint and Oxfmt configuration for modern TypeScript, React, Next.js, TanStack Start, and React Native projects.",
  "keywords": [
    "config",
    "formatter",
    "linter",
    "nextjs",
    "oxc",
    "oxfmt",
    "oxlint",
    "paraglide",
    "react",
    "react-native",
    "tanstack-start",
    "typescript"
  ],
  "homepage": "https://github.com/viclafouch/oxc-config#readme",
  "bugs": {
    "url": "https://github.com/viclafouch/oxc-config/issues"
  },
  "license": "MIT",
  "author": "Victor de la Fouchardiere <victor.delafouchardiere@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viclafouch/oxc-config.git"
  },
  "files": [
    "dist",
    "configs",
    "formatting",
    "index.ts",
    "plugins",
    "!plugins/**/tests"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./formatting": "./dist/formatting/index.mjs",
    "./plugins/viclafouch": "./dist/plugins/viclafouch/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "tsdown && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsdown && oxlint && oxfmt --check",
    "lint:fix": "tsdown && oxlint --fix && oxfmt",
    "prepublishOnly": "tsdown",
    "bump": "npm version minor",
    "release": "npm publish"
  },
  "dependencies": {
    "@oxlint/plugins": "~1.90.0",
    "oxlint-plugin-react-doctor": "^0.9.18"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@inlang/paraglide-js": "^2.29.3",
    "@tanstack/eslint-plugin-query": "^5.104.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^24.19.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-turbo": "^2.11.10",
    "oxfmt": "~0.75.0",
    "oxlint": "~1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@inlang/paraglide-js": ">= 2.29",
    "@tanstack/eslint-plugin-query": ">= 5",
    "@tanstack/eslint-plugin-router": ">= 1.162",
    "eslint-plugin-playwright": ">= 2",
    "eslint-plugin-react-native": ">= 5",
    "eslint-plugin-testing-library": ">= 7",
    "eslint-plugin-turbo": ">= 2",
    "oxfmt": "~0.75.0",
    "oxlint": "~1.90.0",
    "typescript": ">= 5"
  },
  "peerDependenciesMeta": {
    "@inlang/paraglide-js": {
      "optional": true
    },
    "@tanstack/eslint-plugin-query": {
      "optional": true
    },
    "@tanstack/eslint-plugin-router": {
      "optional": true
    },
    "eslint-plugin-playwright": {
      "optional": true
    },
    "eslint-plugin-react-native": {
      "optional": true
    },
    "eslint-plugin-testing-library": {
      "optional": true
    },
    "eslint-plugin-turbo": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.21"
  }
}
